generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  username     String @unique
  passwordHash String
  role         Role   @default(USER)

  items  Item[]  @relation("UserItems")
  orders Order[] @relation("UserOrders")
  sales  Order[] @relation("UserSales")
  messages OrderMessage[] @relation("OrderMessages")
  reviewsGiven Review[] @relation("BuyerReviews")
  reviewsReceived Review[] @relation("SellerReviews")
  sentDirectMessages DirectMessage[] @relation("SentDirectMessages")
  receivedDirectMessages DirectMessage[] @relation("ReceivedDirectMessages")
  buyerPayments Payment[] @relation("BuyerPayments")
  sellerPayments Payment[] @relation("SellerPayments")
  walletTransactions WalletTransaction[]
  balance   Int      @default(1000)

  ownedItems Item[] @relation("ItemOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Item {
  id          String     @id @default(cuid())
  title       String
  description String
  price       Decimal    @db.Decimal(10, 2)
  status      ItemStatus @default(LISTED)

  category    ItemCategory @default(OTHER)

  imageData   Bytes?
  imageMime   String?

  seller   User   @relation("UserItems", fields: [sellerId], references: [id])
  sellerId String

  owner   User?   @relation("ItemOwner", fields: [ownerId], references: [id]) // 🔹 добавляем имя связи
  ownerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

enum ItemCategory {
  ACCOUNTS
  KEYS
  SUBSCRIPTIONS
  SERVICES
  GAME_CURRENCIES
  NFT_TOKENS
  OTHER
}

enum ItemStatus {
  LISTED
  SOLD
}

model Order {
  id        String   @id @default(cuid())
  item      Item     @relation(fields: [itemId], references: [id])
  itemId    String
  buyer     User     @relation(fields: [buyerId], references: [id], name: "UserOrders")
  buyerId   String
  seller    User     @relation(fields: [sellerId], references: [id], name: "UserSales")
  sellerId  String
  price     Decimal  @db.Decimal(10, 2)
  status    OrderStatus @default(PAID)
  deliveryData String?
  confirmedAt DateTime?
  disputedAt DateTime?
  cancelledAt DateTime?
  messages  OrderMessage[]
  review    Review?
  payment   Payment?
  walletTransactions WalletTransaction[]
  createdAt DateTime @default(now())

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  buyer     User     @relation("BuyerReviews", fields: [buyerId], references: [id])
  buyerId   String
  seller    User     @relation("SellerReviews", fields: [sellerId], references: [id])
  sellerId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId, createdAt])
  @@index([buyerId, createdAt])
}

model DirectMessage {
  id          String   @id @default(cuid())
  sender      User     @relation("SentDirectMessages", fields: [senderId], references: [id])
  senderId    String
  recipient   User     @relation("ReceivedDirectMessages", fields: [recipientId], references: [id])
  recipientId String
  body        String
  createdAt   DateTime @default(now())

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

enum OrderStatus {
  PAID
  COMPLETED
  DISPUTED
  CANCELLED
}

model Payment {
  id                String        @id @default(cuid())
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String        @unique
  buyer             User          @relation("BuyerPayments", fields: [buyerId], references: [id])
  buyerId           String
  seller            User          @relation("SellerPayments", fields: [sellerId], references: [id])
  sellerId          String
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  provider          String?
  providerPaymentId String?       @unique
  releasedAt        DateTime?
  refundedAt        DateTime?
  walletTransactions WalletTransaction[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
}

model WalletTransaction {
  id           String                @id @default(cuid())
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId      String?
  payment      Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paymentId    String?
  type         WalletTransactionType
  amount       Decimal               @db.Decimal(10, 2)
  balanceAfter Int
  note         String?
  createdAt    DateTime              @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([paymentId])
}

enum PaymentMethod {
  BALANCE
  CARD
  SBP
}

enum PaymentStatus {
  PENDING
  PAID
  RELEASED
  REFUNDED
  FAILED
}

enum WalletTransactionType {
  PURCHASE_HOLD
  REFUND
  SALE_RELEASE
}

model OrderMessage {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  author    User     @relation("OrderMessages", fields: [authorId], references: [id])
  authorId  String
  body      String
  type      OrderMessageType @default(TEXT)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

enum OrderMessageType {
  TEXT
  SYSTEM
  DELIVERY
}
